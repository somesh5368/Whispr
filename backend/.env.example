# Copy to .env and fill in values. Never commit .env.

# ==========================================
# Database
# ==========================================
# Production MongoDB Connection URI
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/whispr?retryWrites=true&w=majority

# Separate test database URI (required to run scripts/test-message-events.js)
TEST_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/whispr_test?retryWrites=true&w=majority

# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://your-frontend.vercel.app

# ==========================================
# CORS (optional – comma-separated list of origins)
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ==========================================
# JWT Authentication
# ==========================================
# Must be at least 32 characters long
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars-long
# Configurable JWT Expiry (e.g. 7d, 15m, 24h - default: 7d)
JWT_EXPIRE=7d

# ==========================================
# Cloudinary (profile + message images)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
